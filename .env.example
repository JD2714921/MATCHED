# --- Database -----------------------------------------------------------
# Started by `npm run db:up` (scripts/dev-db.sh).
DATABASE_URL="postgresql://matched:matched@127.0.0.1:5433/matched?schema=public"

# --- Application --------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"
# 32+ random bytes. Used to derive nothing sensitive today, but reserved.
APP_SECRET="change-me-in-any-real-deployment"

# --- Exchange provider ---------------------------------------------------
# "fixture" (default, offline, labelled sample data) or "betfair".
EXCHANGE_PROVIDER="fixture"

# Betfair credentials. NOTE: this environment cannot reach api.betfair.com,
# so the Betfair provider is UNVERIFIED against the live service.
# The certificate/key are read from disk paths; they are never stored in the
# database and never belong to a customer — they are OUR application's
# credentials for OUR read-only market-data key.
BETFAIR_APP_KEY=""
BETFAIR_USERNAME=""
BETFAIR_PASSWORD=""
BETFAIR_CERT_PATH=""
BETFAIR_KEY_PATH=""
# Set true when the app key is a DELAYED key: prices are snapshot-delayed and
# traded volume is not provided.
BETFAIR_KEY_IS_DELAYED="true"

# --- AI provider ---------------------------------------------------------
# "stub" (default, deterministic, rule-based, offline) or "anthropic".
AI_PROVIDER="stub"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
